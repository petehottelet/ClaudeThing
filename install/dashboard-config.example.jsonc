{
  // The order here is the order providers appear on the device. Remove the
  // leading // from any one-line entry to enable it. This file never stores
  // passwords, cookies, tokens, or API keys.
  "version": 1,
  "providers": [
    {
      "id": "claude",
      "enabled": true,
      "show": ["quota", "currentTokens", "history"]
    },
    {
      "id": "codex",
      "enabled": true,
      "show": [
        "quota",
        "resetCredits",
        "currentTokens",
        "lifetimeTokens",
        "peakDailyTokens",
        "streak",
        "history"
      ]
    }

