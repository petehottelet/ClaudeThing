    "propertyName": "Website Analytics",
    "propertyId": ""
  },

  "markets": {
    // Automatic rotation is paused off-screen. Turning the dial changes the
    // instrument immediately and restarts this timer.
    "rotationSeconds": 10,
    "instruments": [
      { "symbol": "NVDA", "name": "NVIDIA", "kind": "stock" },
      { "symbol": "S&P 500", "name": "Large-cap index", "kind": "index" },
      { "symbol": "DOW", "name": "Industrial index", "kind": "index" },
